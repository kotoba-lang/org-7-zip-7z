{:paths ["src"]
 ;; org-tukaani-xz supplies LZMA1/LZMA2 (the coders .7z actually uses) and
 ;; org-ietf-deflate the CRC-32 that every 7z structure carries, plus the
 ;; Deflate coder.
 :deps {io.github.kotoba-lang/org-tukaani-xz {:git/sha "f5d0605128f5b4ae1a6a17460be3afce34fac9fa"}
        io.github.kotoba-lang/org-ietf-deflate {:git/sha "430d754313e9082114ec00554e0b6770d9d318c5"}}
 :aliases
 {:local {:override-deps {io.github.kotoba-lang/org-tukaani-xz {:local/root "../org-tukaani-xz"}
                          io.github.kotoba-lang/org-ietf-deflate {:local/root "../org-ietf-deflate"}}}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
